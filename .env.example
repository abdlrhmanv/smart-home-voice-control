# Local hardware demo (copy to .env — do not commit secrets).

# Find port: ls /dev/ttyACM* /dev/ttyUSB*
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=9600
# Wait for Ahmed PASSWORD_OK buzzer delays before next command
ARDUINO_PASSWORD_SETTLE_S=4.6

# Allow UI unlock even if serial fails (0 = fail closed when hardware required)
ALLOW_OFFLINE_CONTROL=1

WHISPER_SIZE=tiny
SMART_HOME_PASSWORD=open
REQUIRE_KNOWN_SPEAKER=1
