# Copy to .env and adjust (never commit real secrets).

# Serial
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUD=9600
# Allow Streamlit unlock/control when Arduino is disconnected (demos/CI).
ALLOW_OFFLINE_CONTROL=1

# Whisper STT (tiny|base|small|medium|large-v3)
WHISPER_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en

# Auth
SMART_HOME_PASSWORD=open sesame
REQUIRE_KNOWN_SPEAKER=1
MIN_COMMAND_CONFIDENCE=0.55
MIN_SPEAKER_CONFIDENCE=0.45
PASSWORD_MIN_SPEAKER_CONFIDENCE=0.45
